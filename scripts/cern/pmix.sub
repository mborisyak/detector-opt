  1244111331, 4, 0.0, 1
  1244111331, 4, 0.0, 2
  1244111331, 4, 0.1, 0
  1244111331, 4, 0.1, 1
  1244111331, 4, 0.1, 2
  1244111331, 4, 0.25, 0
  1244111331, 4, 0.25, 1
  1244111331, 4, 0.25, 2
)
