universe       = vanilla
executable     = pmix_cell.sh
arguments      = $(seed) $(design) $(pmix) $(trial) /afs/cern.ch/work/m/maborisy/ship-pmix/mix$(pmix)/trial$(trial)
output         = logs/pmix_$(pmix)_$(trial).$(ClusterId).$(ProcId).out
error          = logs/pmix_$(pmix)_$(trial).$(ClusterId).$(ProcId).err
