requirements   = TARGET.GPUs_GlobalMemoryMb >= 10000 && (TARGET.GPUs_Capability =?= undefined || TARGET.GPUs_Capability >= 8.0)
+MaxRuntime    = 72000
+JobBatchName  = "ship-pmix-control"
queue seed,design,pmix,trial from (
  1244111331, 4, 0.0, 0
  1244111331, 4, 0.0, 1
  1244111331, 4, 0.0, 2
  1244111331, 4, 0.1, 0
  1244111331, 4, 0.1, 1
  1244111331, 4, 0.1, 2
  1244111331, 4, 0.25, 0
  1244111331, 4, 0.25, 1
  1244111331, 4, 0.25, 2
)
