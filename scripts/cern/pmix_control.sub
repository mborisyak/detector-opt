universe       = vanilla
executable     = pmix_control_cell.sh
arguments      = $(seed) $(design) $(pmix) $(trial) /afs/cern.ch/work/m/maborisy/ship-pmix/mix$(pmix)/trial$(trial)
output         = logs/pmixctl_$(pmix)_$(trial).$(ClusterId).$(ProcId).out
error          = logs/pmixctl_$(pmix)_$(trial).$(ClusterId).$(ProcId).err
log            = logs/pmixctl.$(ClusterId).log
