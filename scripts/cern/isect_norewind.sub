# ship-intersect-w2x-2m WITH THE REWIND OFF: 5 seeds x all four arms.
# Config differs from the campaign's by exactly `training.rewind` 0.1 -> 0.0; see its header for
# the probe that motivated it and for what that probe does NOT establish.
universe       = vanilla
executable     = geom_cell.sh
arguments      = ship_intersect_prec1e2_w2x_2m_norewind $(seed) $(arm) $(reveal) /afs/cern.ch/work/m/maborisy/ship-intersect-w2x-2m-norewind/$(seed)/$(arm)
