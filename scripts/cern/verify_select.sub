executable     = verify_select_cell.sh
arguments      = $(task) $(seed) $(arm) $(regime) $(tree)
output         = logs/vs_$(task)_$(seed)_$(arm)_$(regime).$(ClusterId).$(ProcId).out
error          = logs/vs_$(task)_$(seed)_$(arm)_$(regime).$(ClusterId).$(ProcId).err
log            = logs/verify_select.$(ClusterId).log
request_gpus   = 1
request_cpus   = 2
request_memory = 12000
requirements   = TARGET.GPUs_GlobalMemoryMb >= 20000
+MaxRuntime    = 172800
+JobBatchName  = "ship-verify-select"
